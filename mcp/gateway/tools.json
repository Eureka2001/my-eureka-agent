        ],
        "title": "qr_backendsOutput",
        "type": "object"
      }
    },
    {
      "name": "score_task",
      "backend": "habitica",
      "description": "打卡或取消打卡一次；可能改变经验、生命值和金币，不要自动重复调用。\n\nArgs:\n    task_id: 任务 UUID 或别名。\n    direction: up=正向习惯/完成 daily 或 todo/兑换自定义 reward（扣金币）；\n        down=负向习惯/取消 daily 或 todo 完成。reward 仅支持 up。\n",
      "inputSchema": {
        "properties": {
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "direction": {
            "enum": [
              "up",
              "down"
            ],
            "title": "Direction",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "direction"
        ],
        "title": "score_taskArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "score_taskDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false
      }
    },
    {
      "name": "understand_image",
      "backend": "vision",
      "description": "用多模态大模型理解图片，返回文字描述或对 prompt 的回答。\n\n    适用：海报、图表、场景图、UI 截图等需要「语义理解」的场景。\n    如果是纯粹的文档/PDF 文字抽取请用 eureka_ocr server（更便宜）；二维码解码请用 eureka_qrcode server。\n\n    Args:\n        image: 图片来源：本地路径 / http(s) URL / data: URI / 裸 base64。\n        prompt: 想让模型回答的问题或指令，默认「描述图片内容」。\n        backend: glm 或 qwen；留空则读环境变量 VISION_BACKEND（默认 glm）。\n    ",
      "inputSchema": {
        "properties": {
          "image": {
            "title": "Image",
            "type": "string"
          },
          "prompt": {
            "default": "请详细、准确地描述这张图片的内容，这张图片是什么类型，主要内容是什么，有无需要额外关注的元素。",
            "title": "Prompt",
            "type": "string"
          },
          "backend": {
            "default": "",
            "title": "Backend",
            "type": "string"
          }
        },
        "required": [
          "image"
        ],
        "title": "understand_imageArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "understand_imageOutput",
        "type": "object"
      }
    },
    {
      "name": "update_checklist_item",
      "backend": "habitica",
      "description": "设置清单项的文字和完成状态；先查询并保留不想修改的值。\n\nArgs:\n    task_id: daily 或 todo 的任务 ID。\n    item_id: 清单项 UUID。\n    text: 清单项文字。\n    completed: true=完成，false=未完成。设为明确状态，不做反转操作。\n",
      "inputSchema": {
        "properties": {
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "item_id": {
            "format": "uuid",
            "title": "Item Id",
            "type": "string"
          },
          "text": {
            "maxLength": 5000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Text",
            "type": "string"
          },
          "completed": {
            "title": "Completed",
            "type": "boolean"
          }
        },
        "required": [
          "task_id",
          "item_id",
          "text",
          "completed"
        ],
        "title": "update_checklist_itemArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "update_checklist_itemDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true
      }
    },
    {
      "name": "update_tag",
      "backend": "habitica",
      "description": "重命名已有标签。",
