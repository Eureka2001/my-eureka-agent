    {
      "name": "playwright_fetch",
      "backend": "fetch",
      "description": "用无头浏览器抓取并渲染网页，返回 markdown 正文；末尾附「图片清单」。\n\n    图片清单只含**客观信息**：分辨率、显示尺寸、字节数、alt、URL（已去重、过滤\n    短边小于 min_short_side 的图标/装饰与 data URI）。\n\n    Args:\n        url: 目标网页地址。\n        wait_seconds: 首屏后额外等待秒数，给 JS/网络完成留时间。\n        scroll_to_load: 是否逐屏滚动以触发懒加载内容。\n        max_chars: 返回（正文+清单）总字符上限。\n        start_index: 从第几个字符开始返回（用于分页续读上次被截断的内容）。\n        precise_sizes: 为 True 时，对未暴露 Content-Length 的图用 httpx 实测字节数（更准但更慢，一般并无必要）。\n        min_short_side: 图片短边最小像素阈值，短边小于此值的图视为图标/装饰而被过滤，默认 100。\n        use_readability: 为 True 时，用 Readability 算法先提取正文区域再转 markdown（去噪更好，适合文章页；对复杂布局页面可能误判，此时建议关闭）。\n    ",
      "inputSchema": {
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "wait_seconds": {
            "default": 2.0,
            "title": "Wait Seconds",
            "type": "number"
          },
          "scroll_to_load": {
            "default": true,
            "title": "Scroll To Load",
            "type": "boolean"
          },
          "max_chars": {
            "default": 20000,
            "title": "Max Chars",
            "type": "integer"
          },
          "start_index": {
            "default": 0,
            "title": "Start Index",
            "type": "integer"
          },
          "precise_sizes": {
            "default": false,
            "title": "Precise Sizes",
            "type": "boolean"
          },
          "min_short_side": {
            "default": 100,
            "title": "Min Short Side",
            "type": "integer"
          },
          "use_readability": {
            "default": true,
            "title": "Use Readability",
            "type": "boolean"
          }
        },
        "required": [
          "url"
        ],
        "title": "playwright_fetchArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "playwright_fetchOutput",
        "type": "object"
      }
    },
