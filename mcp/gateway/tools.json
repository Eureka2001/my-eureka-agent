    {
      "name": "update_task",
      "backend": "habitica",
      "description": "局部修改任务；只发送指定字段。打卡应调用 score_task。\n\nArgs:\n    task_id: 任务 UUID 或别名。\n    changes: 要修改的字段；notes=\"\" 清空备注，tags=[] 清空标签，date=null 清空截止日期。\n        类型相关字段必须匹配已有任务类型，由 Habitica 检查。\n",
      "inputSchema": {
        "$defs": {
          "Difficulty": {
            "enum": [
              0.1,
              1.0,
              1.5,
              2.0
            ],
            "title": "Difficulty",
            "type": "number"
          },
          "TaskUpdate": {
            "additionalProperties": false,
            "properties": {
              "text": {
                "anyOf": [
                  {
                    "maxLength": 5000,
                    "minLength": 1,
                    "pattern": "\\S",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Text"
              },
              "notes": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Notes"
              },
              "priority": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Difficulty"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "tags": {
                "anyOf": [
                  {
                    "items": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Tags"
              },
              "attribute": {
                "anyOf": [
                  {
                    "enum": [
                      "str",
                      "int",
                      "per",
                      "con"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Attribute"
              },
              "alias": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_-]+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Alias"
              },
              "date": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "format": "date-time",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Date"
              },
              "frequency": {
                "anyOf": [
                  {
                    "enum": [
                      "daily",
                      "weekly",
                      "monthly",
                      "yearly"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Frequency"
              },
              "everyX": {
                "anyOf": [
                  {
                    "maximum": 9999,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Everyx"
              },
              "repeat": {
                "anyOf": [
                  {
                    "additionalProperties": {
                      "type": "boolean"
                    },
                    "propertyNames": {
                      "enum": [
                        "su",
                        "m",
                        "t",
                        "w",
                        "th",
                        "f",
                        "s"
                      ]
                    },
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Repeat"
              },
              "startDate": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "format": "date-time",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Startdate"
              },
              "daysOfMonth": {
                "anyOf": [
                  {
                    "items": {
                      "maximum": 31,
                      "minimum": 1,
                      "type": "integer"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Daysofmonth"
              },
              "weeksOfMonth": {
                "anyOf": [
                  {
                    "items": {
                      "type": "integer"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Weeksofmonth"
              },
              "up": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Up"
              },
              "down": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Down"
              },
              "value": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Value"
              },
              "collapseChecklist": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Collapsechecklist"
              }
            },
            "title": "TaskUpdate",
            "type": "object"
          }
        },
        "properties": {
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "changes": {
            "$ref": "#/$defs/TaskUpdate"
          }
        },
        "required": [
          "task_id",
          "changes"
        ],
        "title": "update_taskArguments",
        "type": "object"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "update_taskDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true
      }
    },
