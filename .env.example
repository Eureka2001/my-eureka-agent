# MCP server 凭据模板 —— 复制为 .env 并填入真实值。

# ===== 阿里云 OCR（mcp/ocr）=====
ALIYUN_OCR_AK_ID=
ALIYUN_OCR_AK_SECRET=

# ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# ===== 视觉理解（mcp/vision）=====
# VISION_BACKEND: glm 或 qwen，二选一即可；两个 key 都填则可随时切换
VISION_BACKEND=qwen
DASHSCOPE_API_KEY=sk-
QWEN_VISION_MODEL=qwen3.5-flash

# GLM_API_KEY=
# GLM_VISION_MODEL=glm-4.6v

# 豆包搜索
# VOLCENGINE_ACCESS_KEY=
# VOLCENGINE_SECRET_KEY=
ASK_ECHO_SEARCH_INFINITY_API_KEY=

# ===== Habitica（mcp/habitica，仅 STDIO）=====
HABITICA_USER_ID=
HABITICA_API_TOKEN=
# 可选覆盖；默认自动生成 HABITICA_USER_ID-eureka-habitica
# HABITICA_CLIENT_ID=
